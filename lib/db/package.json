{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "migrate": "tsx ./src/migrate-cli.ts",
    "push": "echo 'drizzle-kit push is disabled: add a SQL file to lib/db/migrations and run pnpm --filter @workspace/db run migrate' && exit 1",
    "test": "bash ./test/run.sh",
    "import-catalog": "tsx ./src/import-catalog.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "catalog:"
  }
}
